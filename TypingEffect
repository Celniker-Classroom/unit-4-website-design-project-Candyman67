<p id= "demo"></p>
<script>
    var i = 0;
    var txt = 'Welcome to the world of music! Explore different genres, artists/composers, and songs to find your favorite genre.';
    var speed = 20;

    function typeWriter() {
        if (i < txt.length) {
            document.getElementById("demo").innerHTML += txt.charAt(i);
            i++;
            setTimeout(typeWriter, speed);
        }
    }

    typeWriter();
</script>